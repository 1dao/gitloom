# Runtime state, not source.
repos/
data/
tmp/
logs/
*.log

# Local overrides: DB passwords, ADMIN_PASSWORD, TLS key paths. Loaded before
# gitloom.cfg and therefore wins over it.
gitloom.local.cfg

# The runtime is NOT tracked. It is copied from xnet2lua per platform, the same
# way ../xpauth does it, so there is nothing here to ignore or to un-ignore —
# bin/ simply never gets added.
#
# It used to say the opposite, and un-ignored bin/ so the binaries could be
# committed. They never were: `git ls-files bin/` was empty the whole time while
# README promised a clone that runs with no toolchain. Both now say the same
# thing, which is the thing that is true.
bin/
